<div class="container text-center p-4" style="background: lightblue; height: 1000px;">
  <h1 class="head py-3">Borgers</h1>
  <div class="row py-3">
    <div class="col-md-6">
      <h2 class="pbx  -3">Borgers that have not been devoured</h2>

      <ul>
        {{#each burgers}}
        {{#unless devoured}}
        <h4>{{this.burger_name}} <button=id="devour{{this.burger_name}}" class="btn btn-lg btn-outline-dark change-devour">Devour da
            borger</button></h4>

        </br>
        {{/unless}}
        {{/each}}
      </ul>


    </div>

    <div class="col-md-6">

      <h2>Borgers that have been devoured</h2>

      <ul>
        {{#each burgers}}
        {{#if devoured}}
        <h4>{{this.burger_name}}</h4>
        {{/if}}
        {{/each}}
      </ul>

    </div>
  </div>

  <div id="addBurger" class="py-3">
    <h2>Add a Borger</h2>
    <br>
    <div>
      <form action="/" method="POST">
        <textarea type="text" name="burger"></textarea>

        <button class="sub-btn" type="submit">Submit</button>
      </form>
    </div>
  </div>


  <a href="/api/burgers">API Data burgers</a>
</div>

<script src="/assets/js/app.js"></script>