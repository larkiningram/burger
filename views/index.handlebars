<div class="container text-center p-4" style="background: lightblue; height: 1000px;">
  <h1 class="head py-3">Borgers</h1>
  <div class="row py-3">
    <div class="col-md-6">
      <h2 class="pbx  -3">Borgers that have not been devoured</h2>

      {{!-- <ul>
        {{#each burgers}}
        {{#unless devoured}}
        <h4>
          {{this.burger_name}}
          <button=id="devour{{this.burger_name}}" class="btn btn-lg btn-outline-dark change-devour">
            Devour da borger
            </button>
        </h4>

        </br>
        {{/unless}}
        {{/each}}
      </ul> --}}

      <div class="container">
        <div class="centered" class="list">
          {{!-- <h2>Burgers:</h2> --}}
          <ul class="list-group" style="align-content: center;
	align-content: center; ">
            {{#each burgers}}
            {{#unless this.devoured}}
            <li class="list-group-item list-group-item">
              {{this.burger_name}}

              <form action="/{{this.id}}?_method=PUT" method="POST">
                <input type="hidden" name="devoured" value="true">
                <button type="submit" class="btn btn-outline-dark">Devour it!</button>
              </form>
            </li>
            {{/unless}}
            {{/each}}
          </ul>
        </div>
      </div>


    </div>

    <div class="col-md-6">

      <h2>Borgers that have been devoured</h2>

      <ul>
        {{#each burgers}}
        {{#if devoured}}
        <h4>{{this.burger_name}}</h4>
        {{/if}}
        {{/each}}
      </ul>

    </div>
  </div>

  <div id="addBurger" class="py-3">
    <h2>Add a Borger</h2>
    <br>
    <div>
      <form class="create-form" action="/" method="POST">
        <textarea id="burgName" type="text" name="burger"></textarea>

        <button class="sub-btn" type="submit">Submit</button>
      </form>
    </div>
  </div>


  <a href="/api/burgers">API Data burgers</a>
</div>

<script src="/assets/js/app.js"></script>